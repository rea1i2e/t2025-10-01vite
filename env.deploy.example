# GitHub Actions 用シークレットのローカル定義
# このファイルを .env.deploy にコピーして値を設定し、scripts/setup-secrets.sh で反映する
# .env.deploy は .gitignore に含まれるためコミットされない

# --- 必須（FTPデプロイ用） ---
FTP_SERVER=
FTP_USERNAME=
FTP_PASSWORD=

# --- 任意（Discord 通知） ---
# DISCORD_WEBHOOK=

# --- 任意（サマリー・通知に表示するURL） ---
# 自動生成（generate-env-deploy）では案件 ID が YYYY-MM-DDxx のとき、検証 Basic と同じ短い user:pass を埋め込む例:
# TEST_URL=https://USER:PASS@YOUR-CASE-ID.rea1i2e.net/
# TEST_URL=

# --- 任意（フォーム送信・テスト環境用） ---
# 設定して setup-secrets.sh を実行すると Secrets に登録され、
# GitHub Actions がビルド後に dist/MailForm01_utf8/mail-config.local.php を生成して FTP する
# （テスト環境で送信確認する場合のみ。ローカルの mail-config.local.php には本番値を入れる — architecture.md §3.25）
# FORM_MAIL_TO=
# FORM_MAIL_FROM=
# SITE_DOMAIN=YOUR-CASE-ID.rea1i2e.net
